{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Benchmarks import the package by name so they run the built `dist`; types come from `src`.
    "paths": { "llmmend": ["./src/index.ts"], "llmmend/*": ["./src/*/index.ts"] }
  },
  "include": ["src", "test", "site/src"]
}
