{
  "name": "llmmend",
  "version": "0.3.0",
  "description": "Extract & repair JSON from LLM replies, parse SSE streams from any provider, token-aware text chunking. Zero deps, TS-first.",
  "keywords": [
    "anthropic",
    "chunking",
    "json",
    "json-repair",
    "llm",
    "openai",
    "partial-json",
    "rag",
    "server-sent-events",
    "sse",
    "standard-schema",
    "streaming",
    "text-splitter",
    "zod"
  ],
  "homepage": "https://nightlightmare.github.io/llmmend/",
  "bugs": "https://github.com/nightlightmare/llmmend/issues",
  "license": "MIT",
  "author": "nightlightmare",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightlightmare/llmmend.git"
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./json": {
      "import": {
        "types": "./dist/json/index.d.ts",
        "default": "./dist/json/index.js"
      },
      "require": {
        "types": "./dist/json/index.d.cts",
        "default": "./dist/json/index.cjs"
      }
    },
    "./sse": {
      "import": {
        "types": "./dist/sse/index.d.ts",
        "default": "./dist/sse/index.js"
      },
      "require": {
        "types": "./dist/sse/index.d.cts",
        "default": "./dist/sse/index.cjs"
      }
    },
    "./chunk": {
      "import": {
        "types": "./dist/chunk/index.d.ts",
        "default": "./dist/chunk/index.js"
      },
      "require": {
        "types": "./dist/chunk/index.d.cts",
        "default": "./dist/chunk/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webkit": "vitest run --config vitest.webkit.config.ts",
    "coverage": "vitest run --coverage",
    "bench": "pnpm build && vitest bench --run --reporter=verbose",
    "smoke": "node scripts/smoke.mjs",
    "smoke:workers": "node scripts/smoke-workers.mjs",
    "drift": "node scripts/drift.mjs",
    "record": "node scripts/record-fixture.mjs",
    "size": "size-limit",
    "check:publish": "publint && attw --pack . --profile node16",
    "changeset": "changeset",
    "check:docs": "node scripts/check-i18n.mjs && node scripts/check-examples.mjs && node scripts/llms.mjs --check",
    "site:dev": "vite --config site/vite.config.mjs",
    "site:build": "vite build --config site/vite.config.mjs",
    "examples:check": "pnpm --filter llmmend-example-* check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@lobehub/icons-static-svg": "^1.98.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "arktype": "^2.2.9",
    "eventsource-parser": "4.1.2",
    "fast-check": "^4.10.2",
    "js-tiktoken": "1.0.21",
    "jsonrepair": "3.15.0",
    "lucide-static": "^1.61.0",
    "miniflare": "4.20260730.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "partial-json": "0.1.7",
    "playwright": "1.64.1",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "size-limit": [
    {
      "name": "llmmend (import { extractJson })",
      "path": "dist/index.js",
      "import": "{ extractJson }",
      "limit": "3.5 kB"
    },
    {
      "name": "llmmend/json",
      "path": "dist/json/index.js",
      "limit": "5 kB"
    },
    {
      "name": "llmmend/json (import { extractTag, extractAllTags })",
      "path": "dist/json/index.js",
      "import": "{ extractTag, extractAllTags }",
      "limit": "1.5 kB"
    },
    {
      "name": "llmmend/json (import { extractCodeBlocks })",
      "path": "dist/json/index.js",
      "import": "{ extractCodeBlocks }",
      "limit": "1 kB"
    },
    {
      "name": "llmmend/sse (import { parseSSE })",
      "path": "dist/sse/index.js",
      "import": "{ parseSSE }",
      "limit": "1 kB"
    },
    {
      "name": "llmmend/sse (import { streamLlm, streamText })",
      "path": "dist/sse/index.js",
      "import": "{ streamLlm, streamText }",
      "limit": "4 kB"
    },
    {
      "name": "llmmend/sse (import { collectText })",
      "path": "dist/sse/index.js",
      "import": "{ collectText }",
      "limit": "6 kB"
    },
    {
      "name": "llmmend/sse (import { streamToolCalls })",
      "path": "dist/sse/index.js",
      "import": "{ streamToolCalls }",
      "limit": "6.5 kB"
    },
    {
      "name": "llmmend/sse (import { streamJson })",
      "path": "dist/sse/index.js",
      "import": "{ streamJson }",
      "limit": "7 kB"
    },
    {
      "name": "llmmend/chunk",
      "path": "dist/chunk/index.js",
      "limit": "2 kB"
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ]
  }
}
