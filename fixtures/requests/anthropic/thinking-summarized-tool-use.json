{
  "description": "Summarized thinking with signature, parallel tool use with eager input streaming.",
  "body": {
    "model": "claude-opus-5-5",
    "max_tokens": 8192,
    "stream": true,
    "thinking": {
      "type": "adaptive",
      "display": "summarized"
    },
    "output_config": {
      "effort": "medium"
    },
    "tools": [
      {
        "name": "get_weather",
        "description": "Get the current weather for a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "City name"
            }
          },
          "required": ["city"],
          "additionalProperties": false
        },
        "eager_input_streaming": true
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "What is the weather in Paris and in Tokyo right now? Call the tool for both cities."
      }
    ]
  }
}
