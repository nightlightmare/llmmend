{
  "description": "Tool calls through OpenRouter routing.",
  "body": {
    "model": "openai/gpt-5-mini",
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Get the current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string",
                "description": "City name"
              }
            },
            "required": ["city"],
            "additionalProperties": false
          }
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "What is the weather in Paris and in Tokyo right now? Call the tool for both cities."
      }
    ]
  }
}
