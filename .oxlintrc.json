{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expectInvariants"]
      }
    ]
  },
  "ignorePatterns": ["dist", "coverage", "site/dist", "site/.pages", "**/.next"]
}
